    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.47.2",
    "axe-core": "^4.10.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  }
}
