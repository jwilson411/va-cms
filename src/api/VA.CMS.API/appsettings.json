{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Sinks": {
      "Console":  { "Enabled": true, "Format": null },
      "File":     { "Enabled": false, "Path": "", "RetainedFileCountLimit": 31, "FileSizeLimitBytes": 104857600, "Shared": false },
      "EventLog": { "Enabled": false, "Source": "VA CMS API", "LogName": "Application", "MinimumLevel": "Warning" },
      "Splunk":   { "Enabled": false, "HecUrl": "", "Token": "", "Index": "", "Source": "va-cms-api", "SourceType": "_json", "MinimumLevel": "Information" }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Media": {
    "Scanner": {
      "Mode": "Disabled",
      "Host": "localhost",
      "Port": 0,
      "ServicePath": "/avscan",
      "TimeoutSeconds": 30,
      "FailClosed": null
    }
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "va-cms-api",
    "Audience": "va-cms-spa"
  }
